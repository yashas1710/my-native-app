# Firebase project containing the application database.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Service account email from its Firebase JSON credential.
FIREBASE_CLIENT_EMAIL=your-service-account-email
# Private key ID from the service account JSON credential.
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
# Client ID from the service account JSON credential.
FIREBASE_CLIENT_ID=your-service-account-client-id
# Client X509 certificate URL from the service account JSON credential.
FIREBASE_CLIENT_X509_CERT_URL=https://example.com/your-client-certificate
# Base64 encoding of the service account private_key string, preserving its newlines.
FIREBASE_PRIVATE_KEY_BASE64=replace-with-base64-encoded-private-key
# Random signing secret of at least 32 characters; do not use a known default.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Exact frontend origin, without a path; optional only in local development.
FRONTEND_URL=https://your-project.vercel.app
# Set production on the deployment host to enforce production startup validation.
NODE_ENV=production
# Optional locally; the deployment host supplies its own listening port.
PORT=5000
