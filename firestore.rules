rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: backend owns all writes (Admin SDK bypasses rules).
    match /users/{userId} {
      allow read, write: if false; 
    }

    // Plans: backend owns all writes.
    match /plans/{planId} {
      allow read, write: if false; 
    }

    // PlanParticipants: backend owns all writes.
    match /planParticipants/{docId} {
      allow read, write: if false; 
    }

    match /planChats/{docId} {
      allow read, write: if false;
    }
  }
}
